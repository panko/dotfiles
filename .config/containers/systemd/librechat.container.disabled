[Unit]
Description=LibreChat AI chat UI
After=network-online.target librechat-mongo.service

[Container]
Image=ghcr.io/librechat-ai/librechat:latest
ContainerName=librechat
PublishPort=127.0.0.1:3080:3080
Volume=%h/containers/librechat/librechat.yaml:/app/librechat.yaml:ro,Z
Environment=HOST=0.0.0.0
Environment=PORT=3080
Environment=MONGO_URI=mongodb://librechat-mongo:27017/LibreChat
Environment=DOMAIN_CLIENT=https://vago.tail601dbf.ts.net/chat
Environment=DOMAIN_SERVER=https://vago.tail601dbf.ts.net/chat
Environment=ALLOW_REGISTRATION=true
Environment=SCHEDULES_SINGLE_PROCESS=true
EnvironmentFile=%h/containers/librechat/secrets.env
Network=vago.network
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
