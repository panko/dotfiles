[Unit]
Description=Zeroclaw AI agent gateway
After=network-online.target

[Container]
Image=ghcr.io/zeroclaw-labs/zeroclaw:latest
ContainerName=zeroclaw
PublishPort=127.0.0.1:42617:42617
Volume=zeroclaw-data:/zeroclaw-data
Environment=ZEROCLAW_gateway__host=0.0.0.0
Environment=ZEROCLAW_gateway__allow_public_bind=true
Environment=ZEROCLAW_gateway__path_prefix=/claw
Environment=ZEROCLAW_providers__models__openai__local__kind=openai-compatible
Environment=ZEROCLAW_providers__models__openai__local__uri=http://llamacpp:8080/v1
Environment=ZEROCLAW_providers__models__openai__local__model=qwen3
Environment=ZEROCLAW_providers__models__openai__local__api_key=local
Network=vago.network
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
